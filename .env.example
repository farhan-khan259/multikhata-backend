PORT=4000
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=multi_khata
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:5173,khata://app,capacitor://localhost,https://localhost,http://localhost
# Used only by npm run admin:create -w backend. Remove the password after bootstrap.
SUPERADMIN_EMAIL=owner@example.com
SUPERADMIN_NAME=Business Owner
SUPERADMIN_PASSWORD=choose-your-own-strong-password
# Google Cloud OAuth web client. Configure the exact callback in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-server.com/api/drive/callback
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DRIVE_TOKEN_KEY=
